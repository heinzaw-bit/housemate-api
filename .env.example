PORT=3001
HOST=127.0.0.1
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
WEB_ORIGINS=http://localhost:3000
# Vercel requires a private job secret. Run npm run cron:secret locally.
# CRON_SECRET=
# Optional trusted database CA certificate PEM when required by your host.
# DATABASE_SSL_CA=
# Optional web push. Keep the private key on the API only.
# Run npm run push:keys once to add keys to ignored .env. Supply a real contact:
# VAPID_SUBJECT=mailto:support@your-domain.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
