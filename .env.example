PORT=3001
HOST=127.0.0.1
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
WEB_ORIGINS=http://localhost:3000
# Optional production error reporting (reporting is disabled outside Vercel production).
# SENTRY_DSN=
# Vercel requires a private job secret. Run npm run cron:secret locally.
# CRON_SECRET=
# Optional trusted CA PEM override; the current Supabase CA is already bundled.
# DATABASE_SSL_CA=
# Optional web push. Keep the private key on the API only.
# Run npm run push:keys once to add keys to ignored .env. Supply a real contact:
# VAPID_SUBJECT=mailto:support@your-domain.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
## Optional server-only natural-language household Q&A. Quick topics need no key.
GEMINI_API_KEY=
# Set true only after checking this key's project says Free Tier with billing disabled.
# This is an operator acknowledgement, not an API verification of Google billing.
GEMINI_FREE_TIER_CONFIRMED=false
